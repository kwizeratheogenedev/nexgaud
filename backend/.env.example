NODE_ENV=development
PORT=4000
# Local MongoDB, or your MongoDB Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/nexguard
# Comma-separated list of allowed dashboard origins
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info

# Required in production: at least 32 random characters each, different from each other.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
HASH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# SMS for sign-in codes: console (prints codes in this terminal) or africastalking
SMS_PROVIDER=console
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
# Country code added to local numbers like 0788123456
DEFAULT_COUNTRY_CODE=250

# Optional: base64 of the Firebase service-account JSON, for instant ring/lock.
# Without it, phones still receive commands each time they upload a location.
FIREBASE_SERVICE_ACCOUNT_B64=

# Stolen-device registry: USSD and SMS checks through Africa's Talking.
# Callback URLs: https://<api>/api/v1/gateway/ussd?key=<GATEWAY_SECRET> and .../gateway/sms?key=<GATEWAY_SECRET>
# At least 16 random characters. Without it the gateway routes are off in production.
GATEWAY_SECRET=
# The USSD code people dial, e.g. *123#, mentioned in SMS replies
USSD_CODE=
# The public check page, e.g. https://nexguard.rw/check, mentioned in SMS replies
PUBLIC_CHECK_URL=

# The dashboard's public address. QR tags link to <PUBLIC_APP_URL>/t/<code>, and SMS to finders link there.
# Set it before printing any tags: printed QR codes cannot change.
PUBLIC_APP_URL=http://localhost:5173

# ---- Plans and payments (Phase 5) ----
# Prices in Rwandan francs: placeholders until the team decides.
PRICE_FAMILY_MONTHLY_RWF=2000
PRICE_LAPTOP_SEAT_MONTHLY_RWF=1000
# Laptops an organisation may add without paying
ORG_FREE_LAPTOPS=5
# What the servers cost per month, for the Phase 5 gate
SERVER_COST_MONTHLY_RWF=0
# The API's public address, so MTN and Airtel can call /api/v1/billing/callbacks/<provider>?key=PAYMENT_CALLBACK_SECRET
PUBLIC_API_URL=
PAYMENT_CALLBACK_SECRET=
# MTN MoMo Collection API. Sandbox: EUR and target "sandbox". Production: MOMO_TARGET_ENV=mtnrwanda, MOMO_CURRENCY=RWF
MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MOMO_TARGET_ENV=sandbox
MOMO_CURRENCY=EUR
MOMO_SUBSCRIPTION_KEY=
MOMO_API_USER=
MOMO_API_KEY=
# Airtel Money Collection API. UAT first, then https://openapi.airtel.africa
AIRTEL_BASE_URL=https://openapiuat.airtel.africa
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=
AIRTEL_COUNTRY=RW
AIRTEL_CURRENCY=RWF

# Bearer token for GET /metrics (Prometheus). Without it, /metrics is off in production.
METRICS_TOKEN=
